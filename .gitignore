# Ignore Linux $HOME dotfiles and caches
.*
!.gitignore
!.dockerignore

# Python caches & logs
__pycache__/
*.py[cod]
*$py.class
*.log
.pytest_cache/
node_modules/

# Optional bulky raw dump (regenerated by `python3 main.py`; compact `xauusd_history_shard.json` is tracked)
data/xauusd_predictions_2012_2026.json
